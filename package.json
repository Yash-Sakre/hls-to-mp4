{
  "name": "hls-to-mp4",
  "version": "0.1.0",
  "description": "Download an HLS stream, or any time range of it, as a single MP4 — entirely in the browser with ffmpeg.wasm. No server, no video re-encoding.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./src/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "demo": "vite --config demo/vite.config.js",
    "demo:build": "vite build --config demo/vite.config.js",
    "samples": "bash scripts/make-samples.sh",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "node test/e2e/run.mjs",
    "bench": "node --expose-gc test/bench/node.mjs && node test/bench/run.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "keywords": [
    "hls",
    "m3u8",
    "mp4",
    "download",
    "export",
    "remux",
    "ffmpeg",
    "ffmpeg.wasm",
    "wasm",
    "video",
    "browser",
    "react"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "react": ">=16.8"
  },
  "peerDependenciesMeta": {
    "@ffmpeg/core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright-core": "^1.60.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.0"
  }
}
